{
	"info": {
		"name": "BookNook API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Catalog",
			"item": [
				{
					"name": "Reset data",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/test/reset",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"test",
								"reset"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));"
								]
							}
						}
					]
				},
				{
					"name": "Browse all books",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/books",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"books"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"pm.test('Response is JSON', () => {",
									"  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
									"});",
									"pm.test('Responds in under 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
									"const body = pm.response.json();",
									"pm.test('TC-2.3 page 1 shows 20 of 30 books', () => {",
									"  pm.expect(body.total).to.eql(30);",
									"  pm.expect(body.totalPages).to.eql(2);",
									"  pm.expect(body.books).to.have.lengthOf(20);",
									"});",
									"const book = body.books.find(b => b.stock > 0);",
									"pm.environment.set('bookId', book.id);",
									"pm.environment.set('bookPrice', book.price);"
								]
							}
						}
					]
				},
				{
					"name": "Search by partial title",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/books?q=prag",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"books"
							],
							"query": [
								{
									"key": "q",
									"value": "prag"
								}
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('TC-2.1 \"prag\" finds The Pragmatic Programmer', () => {",
									"  pm.expect(body.total).to.eql(1);",
									"  pm.expect(body.books[0].title).to.eql('The Pragmatic Programmer');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Page 2",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/books?page=2",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"books"
							],
							"query": [
