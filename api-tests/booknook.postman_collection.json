				{
					"name": "Add book to cart",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/cart",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"cart"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"bookId\": {{bookId}},\n  \"qty\": 2\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 201', () => pm.response.to.have.status(201));",
									"const cart = pm.response.json();",
									"const price = pm.environment.get('bookPrice');",
									"pm.test('Line total and subtotal are price x 2', () => {",
									"  pm.expect(cart.items[0].lineTotal).to.eql(price * 2);",
									"  pm.expect(cart.subtotal).to.eql(price * 2);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Get cart",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/cart",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"cart"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"pm.test('Cart was kept between requests', () => {",
									"  pm.expect(pm.response.json().items).to.have.lengthOf(1);",
									"});",
									"const cartSchema = {",
									"  type: 'object',",
									"  required: ['items', 'discounts', 'subtotal', 'discount', 'shipping', 'total'],",
									"  properties: {",
									"    items: { type: 'array', items: { type: 'object', required: ['bookId', 'title', 'price', 'qty', 'lineTotal'],",
									"      properties: { bookId: { type: 'integer' }, title: { type: 'string' }, price: { type: 'integer' }, qty: { type: 'integer' }, lineTotal: { type: 'integer' } } } },",
									"    discounts: { type: 'array', items: { type: 'string' } },",
									"    subtotal: { type: 'integer' }, discount: { type: 'integer' }, shipping: { type: 'integer' }, total: { type: 'integer' }",
									"  }",
									"};",
									"pm.test('Matches the cart contract', () => pm.response.to.have.jsonSchema(cartSchema));"
								]
							}
						}
					]
				},
				{
					"name": "Remove book",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/cart/{{bookId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
