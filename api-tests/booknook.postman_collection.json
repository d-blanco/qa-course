									"const cart = pm.response.json();",
									"pm.test('Cart is empty and totals are zero', () => {",
									"  pm.expect(cart.items).to.be.empty;",
									"  pm.expect(cart.subtotal).to.eql(0);",
									"  pm.expect(cart.total).to.eql(0);",
									"});"
								]
							}
						}
					]
				},
