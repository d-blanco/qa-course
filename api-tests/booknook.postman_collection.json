						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('TC-2.3 page 2 shows the last 10 books', () => {",
									"  pm.expect(body.page).to.eql(2);",
									"  pm.expect(body.books).to.have.lengthOf(10);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Search with no matches",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/books?q=zzz",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"books"
							],
							"query": [
								{
									"key": "q",
									"value": "zzz"
								}
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('TC-2.4 no matches returns an empty list', () => {",
									"  pm.expect(body.total).to.eql(0);",
									"  pm.expect(body.books).to.be.empty;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Book not found",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/books/999",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"books",
								"999"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 404', () => pm.response.to.have.status(404));",
									"pm.test('Error code is E_NOT_FOUND', () => pm.expect(pm.response.json().err).to.eql('E_NOT_FOUND'));"
								]
							}
						}
					]
				},
				{
					"name": "Book details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/books/{{bookId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"books",
								"{{bookId}}"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"pm.test('Returns the requested book', () => {",
									"  pm.expect(pm.response.json().id).to.eql(pm.environment.get('bookId'));",
									"});",
									"const bookSchema = {",
									"  type: 'object',",
									"  required: ['id', 'title', 'author', 'category', 'price', 'stock', 'rating', 'description'],",
									"  properties: {",
									"    id: { type: 'integer' }, title: { type: 'string' }, author: { type: 'string' }, category: { type: 'string' },",
									"    price: { type: 'integer', minimum: 0 }, stock: { type: 'integer', minimum: 0 },",
									"    rating: { type: 'number', minimum: 0, maximum: 5 }, description: { type: 'string' }",
									"  }",
									"};",
									"pm.test('Matches the book contract', () => pm.response.to.have.jsonSchema(bookSchema));"
								]
							}
						}
					]
				}
			]
		},
